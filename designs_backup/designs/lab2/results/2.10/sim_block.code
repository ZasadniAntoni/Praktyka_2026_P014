name=sim_block only_toplevel=false
value="
.param VDD = 1.8
.param RES_DAC = 11.37k
.param dac_bit = 31
.options savecurrents

.control
  let runs = 100
  shell mkdir -p /foss/designs/lab2/results/2.6
  shell rm -f /foss/designs/lab2/results/2.6/DAC_stats.dat /foss/designs/lab2/results/2.6/DAC_Iruns.dat

  * allocate vector for currents
  let Ivec = vector(runs)
  let r = 0
  let dac_val = 31

  reset
  op
  
  let I_ref = @m.xm_ref.xideal.msky130_fd_pr__pfet_01v8[id] * 1e6
  echo ----- dac_bit= $&dac_val I_REF[uA]= $&I_ref ----- >> /foss/designs/lab2/results/2.6/DAC_Iruns.dat
  echo ----- dac_bit= $&dac_val I_REF[uA]= $&I_ref ----- >> /foss/designs/lab2/results/2.6/DAC_stats.dat
  
  dowhile r < runs
    reset
    op
    let Ivec[r] = @res_out[i] * 1e6
    let curI = Ivec[r]
    set appendwrite 
    echo RUN= $&r I[uA]= $&curI >> /foss/designs/lab2/results/2.6/DAC_Iruns.dat
    let r = r + 1
  end

  * calculate stats
  let avgI = mean(Ivec)
  let sigI = stddev(Ivec)
  let ratio = (sigI / avgI) * 100
  let minI = minimum(Ivec)
  let maxI = maximum(Ivec)
  
  echo MIN[uA]= $&minI MAX[uA]= $&maxI AVG[uA]= $&avgI SIGMA[uA]= $&sigI sigma/AVG[%]= $&ratio >> /foss/designs/lab2/results/2.6/DAC_stats.dat
  echo >> /foss/designs/lab2/results/2.6/DAC_stats.dat
.endc
"
