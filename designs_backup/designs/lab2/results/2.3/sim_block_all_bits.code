name=sim_block only_toplevel=false 
value="
.param VDD = 1.8
.param RES_DAC = 11.37k
.param dac_bit = 0
.options savecurrents

.control
  shell mkdir -p /foss/designs/lab2/results/2.3
  shell rm -f /foss/designs/lab2/results/2.3/test_run.dat

  let d_val = 0
  reset
  op
  let Id_ref = @m.xm_ref.msky130_fd_pr__pfet_01v8[id] * 1e6
  let vth_ref = @m.xm_ref.msky130_fd_pr__pfet_01v8[vth]
  let vgs_ref = @m.xm_ref.msky130_fd_pr__pfet_01v8[vgs]
  echo -- Id_M_REF[uA]= $&Id_ref  | Vth_M_REF[V]= $&vth_ref | Vgs_M_REF[V]= $&vgs_ref -- >> /foss/designs/lab2/results/2.3/test_run.dat
  dowhile d_val <= 31
    alterparam dac_bit = $&d_val
    reset
    op
    let I_dac = @res_out[i] * 1e6
    let vb4 = v(\"b[4]\")
    let vb3 = v(\"b[3]\")
    let vb2 = v(\"b[2]\")
    let vb1 = v(\"b[1]\")
    let vb0 = v(\"b[0]\")
    * compose vb values v(\"b[4]\") v(\"b[3]\") v(\"b[2]\") v(\"b[1]\") v(\"b[0]\")
    echo dac_bit= $&d_val  |  I_dac[uA]= $&I_dac >> /foss/designs/lab2/results/2.3/test_run.dat
    * echo Vb\[4:0\]= $&vb >> /foss/designs/lab2/results/2.3/test_run.dat
    echo Vb\[4:0\]= $&vb4 | $&vb3 | $&vb2 | $&vb1 | $&vb0 >> /foss/designs/lab2/results/2.3/test_run.dat
    echo >> /foss/designs/lab2/results/2.3/test_run.dat
    let d_val = $&d_val + 1
  end
.endc
"



